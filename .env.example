APP_ENV=development
PORT=3000
NGINX_PORT=8080
API_V1_PREFIX=api/v1

# Supabase public project configuration. Never put the service-role key here.
SUPABASE_URL=https://your-project.supabase.co
# Optional only when the API container connects to the Supabase CLI stack on the host.
SUPABASE_DOCKER_URL=
SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend only. Required by the one-time password-reset token flow; never use in Flutter.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_RESET_REDIRECT_URL=http://localhost:3000/reset-password
# Backend custom 4-digit password-reset OTP delivery through Brevo SMTP.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_SENDER_EMAIL=verified-sender@your-domain.com
BREVO_SENDER_NAME=SKETCHOO
# Redirect setelah user klik tautan verifikasi email pendaftaran (opsional).
SUPABASE_CONFIRM_REDIRECT_URL=http://localhost:3000/email-verified

# Optional telemetry. Leave empty to disable Observe during local development.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=sketchoo-backend-v2
